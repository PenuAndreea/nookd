{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Restricting to these two avoids an ambient `namespace jest` pulled in
    // transitively by some other package's ".d.ts" shadowing @types/jest's
    // own globals — without this, `jest.fn()` et al type-check as "cannot
    // use namespace 'jest' as a value" in test files.
    "types": ["jest", "node"],
    "paths": {
      "@/assets/*": [
        "./assets/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.ts",
    "metro.config.ts"
  ]
}